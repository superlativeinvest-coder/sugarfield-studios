# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact comma-separated origins permitted in Stripe return URLs. Production
# rollout must include both the public origin and restricted validation origin.
CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000

# Restricted immutable-candidate validation host. Store SHA-256(token), never
# the plaintext token. Leave both blank outside a controlled rollout.
RELEASE_VALIDATION_HOST=
RELEASE_VALIDATION_TOKEN_HASH=

# TikTok Pixel browser base loader. Keep disabled/blank locally. Staging or
# preview requires an explicitly approved test Pixel ID. Production is hard
# disabled in application code until consent/privacy approval is implemented.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ENABLED=false
# NEXT_PUBLIC_TIKTOK_PIXEL_ENV=local

# Stripe server configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional comma-separated additional endpoint secrets, used during validation
# hostname rollout. STRIPE_WEBHOOK_SECRET remains supported.
STRIPE_WEBHOOK_SECRETS=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_DAILY_RESET_PRICE_ID=
STRIPE_MINI_TOOL_PRICE_ID=
STRIPE_COMPANION_PRICE_ID=
STRIPE_ADVENTURE_COMPANION_PRICE_ID=
STRIPE_P18_COMPLETE_PLAYER_SYSTEM_PRICE_ID=
STRIPE_P18_LIVE_PRICE_ID=
STRIPE_P17_STRIPE_PRODUCT_ID=
STRIPE_P17_STANDALONE_PRICE_ID=
STRIPE_P17_UPGRADE_PRICE_ID=

# Supabase server-only order storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-products

# Funnel activation is fail-closed. The first flag requires an approved
# Supabase/Stripe pair; P18 also requires its separate activation flag.
POKOPIA_CUMULATIVE_CHECKOUT_ENABLED=false
P18_CHECKOUT_ACTIVATION_ENABLED=false
P16_STAGED_STORAGE_VERIFIED_VERSION=
P16_PRODUCTION_STORAGE_VERIFIED_VERSION=
P18_STAGED_STORAGE_VERIFIED_VERSION=
P18_PRODUCTION_STORAGE_VERIFIED_VERSION=

# MailerLite server-only lead capture. Create a dedicated group for the
# Pokopia Quick Start Pack, then set its numeric ID below.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
